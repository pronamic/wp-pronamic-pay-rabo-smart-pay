{
	"name": "pronamic/json-schema-compatibility",
	"description": "Isolated runtime dependency and validation tests for JSON Schema compatibility.",
	"license": "GPL-3.0-or-later",
	"repositories": [
		{
			"type": "path",
			"url": "../..",
			"options": {
				"versions": {
					"wp-pay-gateways/omnikassa-2": "dev-main"
				}
			}
		}
	],
	"require": {
		"wp-pay-gateways/omnikassa-2": "dev-main",
		"justinrainbow/json-schema": "^5.2 || ^6.8",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"config": {
		"vendor-dir": "../../build/json-schema/vendor",
		"lock": false,
		"platform": {
			"php": "8.1"
		},
		"allow-plugins": false
	}
}
