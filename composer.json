{
	"name": "wp-pay-gateways/omnikassa-2",
	"description": "Rabo Smart Pay driver for the WordPress payment processing library.",
	"keywords": ["wordpress", "wp", "smart", "pay","omnikassa", "gateway", "pronamic"],
	"homepage": "http://www.wp-pay.org/gateways/omnikassa-2/",
	"license": "GPL-3.0-or-later",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Pronamic",
			"email": "info@pronamic.eu",
			"homepage": "http://www.pronamic.eu/",
			"role": "Company"
		},
		{
			"name": "Remco Tolsma",
			"email": "info@remcotolsma.nl",
			"homepage": "http://www.remcotolsma.nl/",
			"role": "Developer"
		}
	],
	"support": {
		"email": "support@wp-pay.org",
		"issues": "https://github.com/wp-pay-gateways/omnikassa-2/issues",
		"source": "https://github.com/wp-pay-gateways/omnikassa-2"
	},
	"autoload": {
		"psr-4": {
			"Pronamic\\WordPress\\Pay\\Gateways\\OmniKassa2\\": "src/"
		}
	},
	"config": {
		"platform": {
			"php": "8.3"
		},
		"allow-plugins": {
			"roots/wordpress-core-installer": true,
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"automattic/jetpack-autoloader": true,
			"phpstan/extension-installer": true
		},
		"sort-packages": true,
		"wp-slug": "pronamic-pay-rabo-smart-pay"
	},
	"require": {
		"php": ">=8.3",
		"automattic/jetpack-autoloader": "^3.0 || ^4.0 || ^5.0 || ^6.0",
		"justinrainbow/json-schema": "^6.14",
		"pronamic/wp-http": "^1.2",
		"pronamic/wp-number": "^1.4",
		"wp-pay/core": "^4.35"
	},
	"require-dev": {
		"humanmade/psalm-plugin-wordpress": "^3.1",
		"overtrue/phplint": "^9.1",
		"php-coveralls/php-coveralls": "^2.7",
		"phpmd/phpmd": "^2.15",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.3",
		"phpunit/phpunit": "^10.5",
		"pronamic/wp-coding-standards": "^2.2",
		"rector/rector": "^2.6",
		"roots/wordpress": "^6.9",
		"sirbrillig/phpcs-variable-analysis": "^2.13",
		"slevomat/coding-standard": "^8.22",
		"solvebeam/wp-hooks-documentor": "^1.5",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"vimeo/psalm": "^5.26",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*",
		"wp-phpunit/wp-phpunit": "^6.5",
		"wp-plugin/sqlite-database-integration": "^3.1",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore ./build/stage-1/ ./build/pronamic-pay-rabo-smart-pay/",
			"vendor/bin/wp dist-archive ./build/pronamic-pay-rabo-smart-pay/ --plugin-dirname=pronamic-pay-rabo-smart-pay --force"
		],
		"ci": [
			"@phpcs",
			"@phplint",
			"@phpstan",
			"@phpunit",
			"@psalm"
		],
		"coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-clover build/logs/clover.xml --coverage-text",
		"coveralls": "vendor/bin/php-coveralls -v",
		"make-pot": "vendor/bin/wp i18n make-pot . languages/pronamic-pay-rabo-smart-pay.pot --slug=pronamic-pay-rabo-smart-pay --domain=pronamic-pay-rabo-smart-pay --exclude=build,docs,documentation,node_modules,tests,vendor,wordpress,wp-content",
		"phpcbf": "XDEBUG_MODE=off vendor/bin/phpcbf",
		"phpcs": "XDEBUG_MODE=off vendor/bin/phpcs -s -v",
		"phplint": "vendor/bin/phplint",
		"phpmd": "vendor/bin/phpmd src,tests text phpmd.ruleset.xml --suffixes php",
		"phpstan": "vendor/bin/phpstan analyse --memory-limit=-1",
		"phpunit": "vendor/bin/phpunit",
		"psalm": "vendor/bin/psalm",
		"rector": "vendor/bin/rector",
		"build-docs": [
			"vendor/bin/wphd parse src --format=markdown --relative=docs > docs/hooks.md"
		]
	},
	"extra": {
		"installer-paths": {
			"vendor/{$vendor}/{$name}/": [
				"type:wordpress-plugin"
			]
		}
	},
	"repositories": [
		{
			"name": "wp-packages",
			"type": "composer",
			"url": "https://repo.wp-packages.org",
			"only": [
				"wp-plugin/*",
				"wp-theme/*"
			]
		}
	]
}
