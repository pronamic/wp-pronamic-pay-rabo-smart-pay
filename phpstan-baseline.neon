parameters:
	ignoreErrors:
		-
			message: '#^Strict comparison using \!\=\= between null and Pronamic\\WordPress\\Pay\\ContactName will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/AddressTransformer.php

		-
			message: '#^Cannot access property \$name on mixed\.$#'
			identifier: property.nonObject
			count: 1
			path: src/Client.php

		-
			message: '#^Cannot access property \$status on mixed\.$#'
			identifier: property.nonObject
			count: 1
			path: src/Client.php

		-
			message: '#^Method Pronamic\\WordPress\\Pay\\Gateways\\OmniKassa2\\Client\:\:get_payment_brands\(\) should return array\<string\> but returns array\.$#'
			identifier: return.type
			count: 1
			path: src/Client.php

		-
			message: '#^Parameter \#2 \$args of static method Pronamic\\WordPress\\Http\\Facades\\Http\:\:request\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: src/Client.php

		-
			message: '#^Possibly invalid array key type mixed\.$#'
			identifier: offsetAccess.invalidOffset
			count: 1
			path: src/Client.php

		-
			message: '#^Parameter \#1 \$data of static method Pronamic\\WordPress\\Pay\\Gateways\\OmniKassa2\\Error\:\:from_object\(\) expects object, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Error.php

		-
			message: '#^Cannot call method format_i18n_non_trailing_zeros\(\) on int\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Gateway.php

		-
			message: '#^Cannot call method is_whole_number\(\) on int\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Gateway.php

		-
			message: '#^Cannot call method to_int\(\) on int\|Pronamic\\WordPress\\Number\\Number\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Gateway.php

		-
			message: '#^Parameter \#2 \.\.\.\$values of function sprintf expects bool\|float\|int\|string\|null, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Gateway.php

		-
			message: '#^Property Pronamic\\WordPress\\Pay\\Gateways\\OmniKassa2\\Integration\:\:\$api_url \(string\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Integration.php

		-
			message: '#^Parameter \#1 \$data of static method Pronamic\\WordPress\\Pay\\Gateways\\OmniKassa2\\Money\:\:from_object\(\) expects object, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Money.php

		-
			message: '#^Parameter \#1 \$data of static method Pronamic\\WordPress\\Pay\\Gateways\\OmniKassa2\\Notification\:\:from_object\(\) expects stdClass, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Notification.php

		-
			message: '#^Parameter \#1 \$data of static method Pronamic\\WordPress\\Pay\\Gateways\\OmniKassa2\\OrderAnnounceResponse\:\:from_object\(\) expects object, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/OrderAnnounceResponse.php

		-
			message: '#^Method Pronamic\\WordPress\\Pay\\Gateways\\OmniKassa2\\OrderItems\:\:jsonSerialize\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/OrderItems.php

		-
			message: '#^Parameter \#1 \$data of static method Pronamic\\WordPress\\Pay\\Gateways\\OmniKassa2\\OrderResult\:\:from_object\(\) expects object, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/OrderResult.php

		-
			message: '#^Parameter \#1 \$data of static method Pronamic\\WordPress\\Pay\\Gateways\\OmniKassa2\\Transaction\:\:from_object\(\) expects object, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/OrderResult.php

		-
			message: '#^Parameter \#1 \$data of static method Pronamic\\WordPress\\Pay\\Gateways\\OmniKassa2\\OrderResult\:\:from_object\(\) expects object, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/OrderResults.php

		-
			message: '#^Parameter \#1 \$data of static method Pronamic\\WordPress\\Pay\\Gateways\\OmniKassa2\\OrderResults\:\:from_object\(\) expects object, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/OrderResults.php
