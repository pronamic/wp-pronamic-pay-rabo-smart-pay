#, php-format
msgid "Default: <code>%s</code>"
msgstr "Standaard: <code>%s</code>"

#: src/Integration.php:142
msgid "Order ID"
msgstr "Bestelling ID"

#. translators: %s: Rabo Smart Pay field name
#: src/Integration.php:145 src/Integration.php:179 src/Integration.php:204
#, php-format
msgid "This setting defines the Rabo Smart Pay %s field."
msgstr "Deze instelling definieert het Rabo Smart Pay %s veld."

#. translators: %s: <code>shopperBankstatementReference</code>
#: src/Integration.php:160
#, php-format
msgid ""
"The Rabo Smart Pay %s field is the reference a customer will find on their "
"bank statement. Only alphanumeric characters are used, other characters are "
"removed, and the value is shortened to 24 characters."
msgstr ""
"Het Rabo Smart Pay %s veld is de omschrijving die een klant op het "
"bankafschrift terugziet. Alleen alfanumerieke tekens worden gebruikt, andere "
"tekens worden verwijderd en de waarde wordt ingekort tot 24 tekens."

#: src/Integration.php:172
msgid "Default: empty, the field is not sent."
msgstr "Standaard: leeg, het veld wordt niet verzonden."

#: src/Integration.php:176
msgid "Bank statement reference"
msgstr "Omschrijving op bankafschrift"

#. translators: %s: <code>skipHppResultPage</code>
#: src/Integration.php:192
#, php-format
msgid ""
"The Rabo Smart Pay %s field makes it possible to skip the hosted result page "
"(also referred to as the \"Success\" or \"Thank you\" page)."
msgstr ""
"Het Rabo Smart Pay veld %s maakt het mogelijk om de gehoste resultaatpagina "
"over te slaan (ook wel de succes- of bedankpagina genoemd)."

#: src/Integration.php:198 src/Integration.php:201
msgid "Skip hosted result page"
msgstr "Gehoste resultaatpagina overslaan"

