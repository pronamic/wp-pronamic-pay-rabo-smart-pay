#. translators: %s: <code>merchantOrderId</code>
#: src/Integration.php:122
#, php-format
msgid ""
"The Rabo Smart Pay %s field must consist strictly of 24 alphanumeric "
"characters, other characters, such as \".\", \"@\", \" \" (space), etc. are "
"not allowed."
msgstr ""
"Het Rabo Smart Pay %s veld moet strikt uit 24 alfanumerieke tekens bestaan, "
"andere tekens, zoals “.”, “@”, “ ” (spatie), etc. zijn niet toegestaan."

#: src/Integration.php:128 src/Integration.php:166
msgid "Available tags:"
msgstr "Beschikbare tags:"

